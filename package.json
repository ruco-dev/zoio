{
  "name": "zoio",
  "version": "0.1.0",
  "description": "Local-first AI search visibility scanner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruco-dev/zoio.git"
  },
  "type": "module",
  "bin": {
    "zoio": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "check": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test src/**/*.test.ts",
    "lint": "npm run check",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "dev": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
